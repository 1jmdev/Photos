{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!.expo",
            "!dist",
            "!android",
            "!modules/*/android/build",
            "!modules/*/ios/build",
            "!modules/*/ios/Pods",
            "!**/.gradle",
            "!**/.cxx",
            "!**/.kotlin",
            "!ios"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noUnknownAtRules": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4
        }
    }
}
