{
    "expo": {
        "name": "Photos",
        "slug": "Photos",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "photos",
        "userInterfaceStyle": "dark",
        "backgroundColor": "#000000",
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.dev1jm.Photos"
        },
        "plugins": [
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            [
                "expo-media-library",
                {
                    "photosPermission": "Photos needs access to your library to display your photos, videos and albums.",
                    "savePhotosPermission": "Photos needs access to save changes to your library.",
                    "isAccessMediaLocationEnabled": true,
                    "granularPermissions": ["photo", "video"]
                }
            ],
            [
                "expo-location",
                {
                    "locationWhenInUsePermission": "Photos uses location services to show the name of the place where a photo was taken."
                }
            ],
            "expo-image",
            "expo-sqlite",
            "expo-video"
        ],
        "experiments": {
            "reactCompiler": true,
            "tsconfigPaths": true
        }
    }
}
