{
    "name": "Photos",
    "main": "src/main.tsx",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "android:prebuild": "NODE_ENV=production expo prebuild --platform android",
        "android:apk": "bun run android:prebuild && bun run android:apk:release",
        "android:apk:clean": "expo prebuild --clean --platform android && bun run android:apk:release",
        "android:apk:release": "sh -c 'cd android && NODE_ENV=production GRADLE_OPTS=\"--enable-native-access=ALL-UNNAMED\" JAVA_TOOL_OPTIONS=\"--enable-native-access=ALL-UNNAMED\" ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a --parallel --build-cache --configure-on-demand -Dorg.gradle.workers.max=$(nproc)'",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "lint": "biome lint .",
        "format": "biome check --write --unsafe .",
        "check": "biome check ."
    },
    "dependencies": {
        "@maplibre/maplibre-react-native": "^11.5.0",
        "@react-navigation/native": "^7.5.0",
        "@react-navigation/native-stack": "^7.20.0",
        "@rn-primitives/accordion": "^1.5.2",
        "@rn-primitives/alert-dialog": "^1.5.2",
        "@rn-primitives/aspect-ratio": "^1.5.2",
        "@rn-primitives/avatar": "^1.5.2",
        "@rn-primitives/checkbox": "^1.5.2",
        "@rn-primitives/collapsible": "^1.5.2",
        "@rn-primitives/context-menu": "^1.5.2",
        "@rn-primitives/dialog": "^1.5.2",
        "@rn-primitives/dropdown-menu": "^1.5.2",
        "@rn-primitives/hover-card": "^1.5.2",
        "@rn-primitives/label": "^1.5.2",
        "@rn-primitives/menubar": "^1.5.2",
        "@rn-primitives/popover": "^1.5.2",
        "@rn-primitives/portal": "^1.5.3",
        "@rn-primitives/progress": "^1.5.2",
        "@rn-primitives/radio-group": "^1.5.2",
        "@rn-primitives/select": "^1.5.2",
        "@rn-primitives/separator": "^1.5.2",
        "@rn-primitives/slot": "^1.5.2",
        "@rn-primitives/switch": "^1.5.2",
        "@rn-primitives/tabs": "^1.5.2",
        "@rn-primitives/toggle": "^1.5.2",
        "@rn-primitives/toggle-group": "^1.5.2",
        "@rn-primitives/tooltip": "^1.5.2",
        "@shopify/flash-list": "2.0.2",
        "@types/geojson": "^7946.0.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "expo": "~57.0.26",
        "expo-file-system": "~57.0.7",
        "expo-image": "~57.0.5",
        "expo-location": "~57.0.20",
        "expo-media-library": "~57.0.5",
        "expo-sharing": "~57.0.22",
        "expo-splash-screen": "~57.0.9",
        "expo-sqlite": "~57.0.3",
        "expo-system-ui": "~57.0.4",
        "expo-video": "~57.0.5",
        "lucide-react-native": "^1.52.0",
        "nativewind": "^4.2.7",
        "react": "19.3.0",
        "react-native": "0.86",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "~4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.28.0",
        "react-native-skia": "^3.2.0",
        "react-native-worklets": "0.13.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/react": "~19.3.0",
        "babel-preset-expo": "~57.0.13",
        "tailwindcss": "3",
        "typescript": "~7.0.2"
    },
    "private": true
}
